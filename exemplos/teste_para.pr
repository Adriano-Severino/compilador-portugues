imprima("=== Laco para ===");

var total = 0;
para (var i = 0; i < 5; i = i + 1) {
    total = total + i;
}
imprima("Soma de 0 a 4:");
imprima(total);

imprima("=== Para com declaracao tipada ===");
para (inteiro j = 0; j < 3;) {
    imprima(j);
    j = j + 1;
}

imprima("=== Fim ===");

imprima("=== Para sem init ===");
var k = 6;
para (; k < 8; k = k + 1) {
    imprima(k);
}
