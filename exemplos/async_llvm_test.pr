// Teste de async / await no target LLVM
usando Sistema;

função principal() => vazio {
    EscreverLinha("=== Teste Async / Await no Target LLVM ===");
    
    // Teste ler arquivo assíncrono
    var resultado = aguarde LerArquivoAssíncrono("exemplos/async_llvm_test.pr");
    EscreverLinha("Arquivo lido com sucesso.");
    
    // Teste escrever arquivo assíncrono
    var sucesso = aguarde EscreverArquivoAssíncrono("build/teste_async.txt", "Teste de escrita assíncrona");
    EscreverLinha("Escrita realizada: " + sucesso);
    
    EscreverLinha("=== Teste Concluído ===");
}