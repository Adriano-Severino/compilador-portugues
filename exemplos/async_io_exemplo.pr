// Exemplo de I/O assíncrono real usando funções nativas
função principal() => vazio {
    EscreverLinha("Testando I/O assíncrono nativo");
    
    // Chama função assíncrona nativa estática
    var resultado = aguarde LerArquivoAssíncrono("exemplos/async_io_exemplo.pr");
    EscreverLinha("Arquivo lido com sucesso");
}
